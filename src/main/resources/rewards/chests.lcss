chest[type="normal"][grade="luxurious"][city in (5, 6, 7, 8, 9)] {
    &[1 <= level <= 20] {
        astaps.loot.regional_talent_books<3,freedom,resistance,ballad>: 1;
        genshin.avatar_up.heros_wit: 2;
        genshin.currency.mora: "1200~1800";
    }

    &[21 <= level <= 25] {
        astaps.loot.regional_talent_books<3,freedom,resistance,ballad>: 1;
        genshin.avatar_up.heros_wit: "2:95, 3:5";
        genshin.currency.mora: "1440~2160";
    }

    &[level >= 26] {
        astaps.loot.regional_talent_books<3,freedom,resistance,ballad>: 1;
        genshin.avatar_up.heros_wit: "2:90, 3:10";
        genshin.currency.mora: "1440~2160";
    }
}

/* 食谱：合并历史战斗/解谜奖励，按城市、品级、等级匹配。 */
chest[type="normal"][grade="exquisite"][21 <= level <= 25][city=1] {
    genshin.recipe.northern_smoked_chicken.item: 1;
}

chest[type="normal"][grade="exquisite"][21 <= level <= 25][city=2] {
    genshin.recipe.mora_meat.item: 1;
    genshin.recipe.stir_fried_filet.item: 1;
}

chest[type="normal"][grade="precious"][21 <= level <= 25][city=1] {
    genshin.recipe.mushroom_pizza.item: 1;
}

/* 宝箱圣遗物（历史 sourceType 19；city 1-4）。
