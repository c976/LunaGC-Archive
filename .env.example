# Copy this file to .env. Docker Compose reads .env automatically.
GRADLE_IMAGE=gradle:9.8.1-jdk21
NODE_IMAGE=node:22-bookworm-slim
JRE_IMAGE=eclipse-temurin:21-jre
MONGO_IMAGE=mongo:7.0

# Host ports. The game client expects these ports, so dev and run use the same values.
ASTAPS_HTTP_PORT=8088
ASTAPS_GAME_PORT=22101

# MongoDB host ports, published on 127.0.0.1 only. Run and dev use different ports so both can be up.
MONGO_RUN_PORT=27017
MONGO_DEV_PORT=27018

# User the server and dev shell run as. On Linux, set these to the output of `id -u` and `id -g`
# so the container can write to docker_volumes/ and data/. Docker Desktop works with the defaults.
ASTAPS_UID=1000
ASTAPS_GID=1000
